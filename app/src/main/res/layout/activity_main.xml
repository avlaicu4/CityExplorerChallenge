<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="160dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:text="City Explorer Challenge"
                android:textColor="@color/app_text"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/panelChallenge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_challenge_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Active Challenge"
                    android:textColor="@color/app_orange"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChallengeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="No active challenge yet"
                    android:textColor="@color/app_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvChallengeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Tap New Challenge and the app will suggest a nearby place automatically."
                    android:textColor="@color/app_muted_text" />

                <TextView
                    android:id="@+id/tvChallengeCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category: -"
                    android:textColor="@color/app_text" />

                <TextView
                    android:id="@+id/tvChallengeDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Distance: -"
                    android:textColor="@color/app_text" />

                <TextView
                    android:id="@+id/tvChallengeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Status: Waiting"
                    android:textColor="@color/app_green_dark"
                    android:textStyle="italic" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnOpenMap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_orange"
                    android:backgroundTint="@null"
                    android:text="Open Map"
                    android:textAllCaps="false"
                    android:textColor="@color/white" />

                <Button
                    android:id="@+id/btnNewChallenge"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_green"
                    android:backgroundTint="@null"
                    android:text="New Challenge"
                    android:textAllCaps="false"
                    android:textColor="@color/app_text" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/btn_pink_outline"
                android:backgroundTint="@null"
                android:text="Why this challenge?"
                android:textAllCaps="false"
                android:textColor="@color/app_text" />

            <LinearLayout
                android:id="@+id/panelProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_progress_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Progress"
                    android:textColor="@color/app_green_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompletedToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completed today: 0"
                    android:textColor="@color/app_text" />

                <TextView
                    android:id="@+id/tvTotalCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Total completed: 0"
                    android:textColor="@color/app_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHistory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_pink_outline"
                    android:backgroundTint="@null"
                    android:text="History"
                    android:textAllCaps="false"
                    android:textColor="@color/app_text" />

                <Button
                    android:id="@+id/btnStatistics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_pink_outline"
                    android:backgroundTint="@null"
                    android:text="Statistics"
                    android:textAllCaps="false"
                    android:textColor="@color/app_text" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/imgHomeMascot"
        android:layout_width="118dp"
        android:layout_height="118dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="18dp"
        android:layout_marginBottom="22dp"
        android:adjustViewBounds="true"
        android:contentDescription="Excited City Explorer mascot"
        android:scaleType="fitCenter"
        android:src="@drawable/mascot_border_collie" />
</FrameLayout>
