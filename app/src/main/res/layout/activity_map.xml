<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <WebView
        android:id="@+id/mapWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/mapInfoPanel" />

    <LinearLayout
        android:id="@+id/mapInfoPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/app_background"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvMapTarget"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Target: -"
            android:textColor="@color/app_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMapDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/app_orange"
            android:textStyle="bold"
            android:text="Distance: -" />

        <TextView
            android:id="@+id/tvMapCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/app_muted_text"
            android:text="User: -\nDestination: -" />

        <Button
            android:id="@+id/btnCheckCompletion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_orange"
            android:backgroundTint="@null"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:text="Check Completion" />
    </LinearLayout>
</RelativeLayout>
